{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "Debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "Debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Configure Debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake: Configure Release",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "Release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Release",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "Release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Configure Release",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "pyOCD: Flash Debug",
            "type": "process",
            "command": "pyocd",
            "args": [
                "flash",
                "--target", "stm32f407zgtx",
                "--frequency", "1000000",
                "--no-wait",
                "${workspaceFolder}/build/Debug/hello_tinyframe.elf"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build Debug",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "pyOCD: Flash Release",
            "type": "process",
            "command": "pyocd",
            "args": [
                "flash",
                "--target", "stm32f407zgtx",
                "--frequency", "1000000",
                "--no-wait",
                "${workspaceFolder}/build/Release/hello_tinyframe.elf"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build Release",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
